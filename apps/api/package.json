{
  "name": "@survey/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"tsx watch src/main.ts\" \"tsx watch src/worker.ts\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:results": "tsx perf/results-perf.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@node-saml/node-saml": "^5.2.0",
    "@survey/contracts": "workspace:*",
    "@survey/core": "workspace:*",
    "@survey/db": "workspace:*",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.44.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "file-type": "^21.3.4",
    "ioredis": "^5.6.0",
    "nodemailer": "^7.0.5",
    "openid-client": "^6.9.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "pg-boss": "^10.3.0",
    "uuid": "^11.1.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^9.40.0"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.7",
    "concurrently": "^9.2.0",
    "jose": "^6.2.18",
    "pino-pretty": "^13.0.0",
    "selfsigned": "^5.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "xml-crypto": "^6.4.0"
  }
}
