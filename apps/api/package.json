{
  "name": "@survey/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"tsx watch src/main.ts\" \"tsx watch src/worker.ts\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:results": "tsx perf/results-perf.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@survey/contracts": "workspace:*",
    "@survey/core": "workspace:*",
    "@survey/db": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.23.1",
    "pg-boss": "^10.3.0",
    "uuid": "^11.1.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^9.40.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "concurrently": "^9.2.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
