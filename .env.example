# Copy to .env and adjust. Every value below works with `docker compose up -d` as-is.

# NODE_ENV defaults to development for the API. Do not set it here: Vite reads this file and
# would produce development builds of the frontends.
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────
# The API and worker connect as `survey_app`, a role WITHOUT BYPASSRLS, so row-level security
# applies to every query. Migrations and seed scripts connect as the owner role.
DATABASE_URL=postgres://survey_app:survey_app@localhost:5432/survey
DATABASE_OWNER_URL=postgres://survey:survey@localhost:5432/survey
TEST_DATABASE_URL=postgres://survey_app:survey_app@localhost:5432/survey_test
TEST_DATABASE_OWNER_URL=postgres://survey:survey@localhost:5432/survey_test

# ── Redis (rate limits, cache) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# ── HTTP ─────────────────────────────────────────────────────────────
API_PORT=3000
# Public origins of the two frontends (used for links in emails, QR codes and the preview iframe).
APP_URL=http://localhost:5173
RESPONDENT_URL=http://localhost:5174
VITE_RESPONDENT_URL=http://localhost:5174
VITE_ADMIN_ORIGIN=http://localhost:5173

# ── Security ─────────────────────────────────────────────────────────
# At least 32 random characters. Signs CSRF tokens, test links and hashes respondent IPs.
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# true in any deployed environment (requires HTTPS); false for http://localhost
COOKIE_SECURE=false
# open = anyone can sign up and create an org; invite_only = signup disabled
SIGNUP_MODE=open
# New organizations per IP per hour (defaults: 20 in production, 500 elsewhere so tests can sign up freely)
# SIGNUPS_PER_HOUR=20

# ── Email (Mailpit locally: UI at http://localhost:8025) ─────────────
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Survey Platform <no-reply@survey.local>"

# ── Error tracking (optional) ────────────────────────────────────────
SENTRY_DSN=
