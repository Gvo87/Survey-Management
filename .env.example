# Copy to .env and adjust. Every value below works with `docker compose up -d` as-is.

# NODE_ENV defaults to development for the API. Do not set it here: Vite reads this file and
# would produce development builds of the frontends.
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────
# The API and worker connect as `survey_app`, a role WITHOUT BYPASSRLS, so row-level security
# applies to every query. Migrations and seed scripts connect as the owner role.
DATABASE_URL=postgres://survey_app:survey_app@localhost:5432/survey
DATABASE_OWNER_URL=postgres://survey:survey@localhost:5432/survey
TEST_DATABASE_URL=postgres://survey_app:survey_app@localhost:5432/survey_test
TEST_DATABASE_OWNER_URL=postgres://survey:survey@localhost:5432/survey_test

# ── Redis (rate limits, cache) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# ── HTTP ─────────────────────────────────────────────────────────────
API_PORT=3000
# Public origins of the two frontends (used for links in emails, QR codes and the preview iframe).
APP_URL=http://localhost:5173
RESPONDENT_URL=http://localhost:5174
VITE_RESPONDENT_URL=http://localhost:5174
VITE_ADMIN_ORIGIN=http://localhost:5173

# ── Security ─────────────────────────────────────────────────────────
# At least 32 random characters. Signs CSRF tokens, test links and hashes respondent IPs.
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# true in any deployed environment (requires HTTPS); false for http://localhost
COOKIE_SECURE=false
# open = anyone can sign up and create an org; invite_only = signup disabled
SIGNUP_MODE=open
# New organizations per IP per hour (defaults: 20 in production, 500 elsewhere so tests can sign up freely)
# SIGNUPS_PER_HOUR=20
# Encrypts secrets the app must read back: webhook signing secrets and integration tokens (Phase 3A).
# Required in production (32+ random characters). Elsewhere it defaults to a key derived from SESSION_SECRET.
# Changing it makes stored webhook secrets and integration tokens unreadable.
# DATA_ENCRYPTION_KEY=

# ── Email (Mailpit locally: UI at http://localhost:8025) ─────────────
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Survey Platform <no-reply@survey.local>"

# ── Error tracking (optional) ────────────────────────────────────────
SENTRY_DSN=

# ── File storage (SeaweedFS locally; AWS S3 or any S3-compatible service in production) ──
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=survey-files
S3_ACCESS_KEY=survey
S3_SECRET_KEY=survey-dev-secret
# true for SeaweedFS/MinIO; false for AWS S3
S3_FORCE_PATH_STYLE=true
# Create the bucket on startup if it's missing (development convenience)
S3_CREATE_BUCKET=true

# ── Malware scanning of uploads ──────────────────────────────────────
# clamav (required in production) or disabled (development only: files are marked clean unscanned).
# For clamav locally: docker compose --profile scan up -d
MALWARE_SCANNER=disabled
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Email campaigns (Phase 2B) ───────────────────────────────────────
# Campaign emails per organization per rolling 24 hours (protects deliverability).
EMAILS_PER_ORG_PER_DAY=10000
# SNS topic ARNs allowed to post SES bounce/complaint notifications to /api/v1/webhooks/ses.
# Empty disables the endpoint (development: there is no SES).
SES_SNS_TOPIC_ARNS=
# Anonymous surveys: filtered result groups smaller than this are hidden.
ANONYMOUS_MIN_GROUP_SIZE=5

# ── Public API and webhooks (Phase 3A) ───────────────────────────────
# Requests per minute per API key.
API_KEY_REQUESTS_PER_MINUTE=600
# Let webhooks and Slack call private or loopback addresses (localhost receivers). Defaults to true in
# development and false elsewhere; refused in production, where every call is checked (SSRF protection).
# ALLOW_PRIVATE_WEBHOOK_URLS=true

# ── AI summaries (Phase 3B) ──────────────────────────────────────────
# Response text is sent to OpenAI, a third-party processor, when an org admin turns summaries on.
# Without a key (or with AI_PROVIDER=none) the feature is shown as unavailable.
# AI_PROVIDER=fake uses a deterministic stand-in (development and tests only; refused in production).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1
# Tokens per organization per calendar month (super admins can change it per org).
AI_MONTHLY_TOKEN_CAP=500000
# Most recent answers sent per summary.
AI_MAX_ANSWERS=400

# ── Single sign-on (Phase 3B) ────────────────────────────────────────
# dns (default): an org proves it owns an email domain with a TXT record.
# auto: domains are verified when added. Development and end-to-end tests only (refused in production).
# SSO_DOMAIN_VERIFICATION=dns

# ── CAPTCHA (Cloudflare Turnstile). These are Cloudflare's public test keys: always pass. ──
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
