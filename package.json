{
  "name": "survey-management",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @survey/api --filter @survey/web --filter @survey/respondent run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --filter=!@survey/e2e run test",
    "test:unit": "pnpm --filter @survey/core run test",
    "test:integration": "pnpm --filter @survey/api run test",
    "test:e2e": "pnpm --filter @survey/e2e run test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @survey/respondent run size",
    "db:migrate": "pnpm --filter @survey/db run migrate",
    "db:seed": "pnpm --filter @survey/db run seed",
    "db:seed:large": "pnpm --filter @survey/db run seed:large",
    "db:reset": "pnpm --filter @survey/db run reset",
    "perf:results": "pnpm --filter @survey/api run perf:results"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
